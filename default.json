{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "commitMessageExtra": "from {{currentVersion}} to {{newVersion}}",
  "extends": [
    "config:best-practices",
    "group:glimmer",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "schedule:weekends",
    ":pinAllExceptPeerDependencies",
    ":maintainLockFilesDisabled"
  ],
  "labels": ["internal"],
  "major": {
    "semanticCommitScope": "deps-major"
  },
  "minor": {
    "semanticCommitScope": "deps-minor"
  },
  "packageRules": [
    {
      "automerge": true,
      "matchDepTypes": ["devDependencies"],
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "semanticCommitScope": "deps-dev"
    },
    {
      "automerge": true,
      "matchUpdateTypes": ["patch", "pin", "digest"]
    },
    {
      "automerge": true,
      "matchPackageNames": ["pnpm", "node"],
      "matchUpdateTypes": ["patch", "minor", "pin"],
      "rebaseWhen": "behind-base-branch"
    },
    {
      "automerge": false,
      "matchCurrentVersion": "<1.0.0"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "prPriority": -1
    },
    {
      "automerge": false,
      "matchPackageNames": ["ember-cli", "ember-data", "ember-source"],
      "matchUpdateTypes": ["major", "minor"]
    },
    {
      "matchDepTypes": ["action"],
      "pinDigests": false
    },
    {
      "groupName": "stylelint",
      "matchPackageNames": ["stylelint", "stylelint-*"],
      "separateMultipleMajor": false
    },
    {
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["node", "node.js", "@types/node"],
      "groupName": "Node"
    },
    {
      "allowedVersions": "<7",
      "description": "TypeScript 7 drops the JS compiler API that Glint and typescript-eslint need, see https://github.com/Bagaar/ember-graphql-mocking/issues/288",
      "matchPackageNames": ["typescript"]
    },
    {
      "matchDepTypes": ["dependencies"],
      "matchFileNames": ["ember-graphql-mocking/package.json"],
      "rangeStrategy": "widen"
    }
  ],
  "patch": {
    "semanticCommitScope": "deps-patch"
  },
  "prCreation": "not-pending",
  "rebaseWhen": "conflicted",
  "separateMultipleMajor": true
}
